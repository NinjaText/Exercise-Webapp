{
  "name": "inmotus-rx-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor shell for the Inmotus RX iOS and Android apps. Loads the hosted web app.",
  "scripts": {
    "sync": "node scripts/write-www-config.cjs && cap sync",
    "verify": "node scripts/verify.cjs",
    "verify:release": "node scripts/verify.cjs --release",
    "test": "node --test 'scripts/*.test.cjs'",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "run:ios": "cap run ios",
    "run:android": "cap run android",
    "assets:placeholder": "node scripts/make-placeholder-assets.cjs",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#3F46C8' --iconBackgroundColorDark '#151a2e' --splashBackgroundColor '#3F46C8' --splashBackgroundColorDark '#151a2e'",
    "version:set": "node scripts/set-version.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "typescript": "^5.9.3"
  }
}
