    "db:backfill-is-assessment": "npx tsx lib/db/scripts/backfill-is-assessment.ts",
    "db:backfill-schedule-variance": "npx tsx lib/db/scripts/backfill-schedule-variance.ts",
    "tag-exercises": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' lib/db/seed/tag-exercises-ai.ts",
    "postinstall": "prisma generate"
  },
